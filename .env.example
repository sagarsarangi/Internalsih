# Supabase Database & Realtime
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Admin Authentication (HS256 JWT cookie)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password
SESSION_SECRET=your_32_byte_base64_session_secret

# Geocoding (LocationIQ with OpenStreetMap fallback)
LOCATIONIQ_API_KEY=your_locationiq_api_key
LOCATIONIQ_REGION=us

# Emergency Channel 1: Telegram Bot API
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_BOT_USERNAME=IntSih_bot
TELEGRAM_ALERT_CHAT_ID=your_telegram_chat_or_channel_id

# Emergency Channel 2: Email SMTP (Gmail / Custom SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
SMTP_FROM="Emergency Dispatch <alerts@emergency.local>"

# Emergency Channel 3: SMS Dispatch (TextBee Gateway)
TEXTBEE_API_KEY=your_textbee_api_key
# Optional: defaults to the active device with the most recent heartbeat if omitted
TEXTBEE_DEVICE_ID=

# Hardware Webhook (IoT Smart Helmet -> /api/hardware-webhook)
# 10-digit Indian phone number to auto-SMS when the helmet confirms a crash
HARDWARE_SMS_RECIPIENT=9876543210